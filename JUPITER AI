0.2); \n            display: flex; \n            justify-content: space-between; \n            align-items: center; \n        }\n\n        .brand-box {\n            display: flex;\n            align-items: center;\n            gap: 0.75rem;\n        }\n\n        .brand-logo {\n            width: 42px;\n            height: 42px;\n            border-radius: 10px;\n            box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);\n            border: 1px solid rgba(168, 85, 247, 0.5);\n        }\n\n        header h1 { \n            font-size: 1.25rem; \n            background: linear-gradient(90deg, #38bdf8, #a855f7);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            font-weight: 800;\n            letter-spacing: 0.5px;\n        }\n\n        .tags { display: flex; gap: 0.5rem; }\n        .tag { \n            font-size: 0.75rem; \n            background: rgba(30, 41, 59, 0.8); \n            border: 1px solid rgba(255, 255, 255, 0.1);\n            padding: 0.25rem 0.6rem; \n            border-radius: 999px; \n            color: #94a3b8; \n        }\n\n        /* Chat area */\n        #chat-window { \n            flex: 1; \n            overflow-y: auto; \n            padding: 1.5rem; \n            display: flex; \n            flex-direction: column; \n            gap: 1.2rem; \n        }\n\n        /* Welcome Banner */\n        .welcome-card {\n            text-align: center;\n            margin: auto auto 1rem auto;\n            max-width: 500px;\n            padding: 2rem;\n            background: rgba(15, 23, 42, 0.6);\n            border: 1px solid rgba(56, 189, 248, 0.2);\n            border-radius: 16px;\n            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);\n        }\n\n        .welcome-logo {\n            width: 80px;\n            height: 80px;\n            border-radius: 18px;\n            margin-bottom: 1rem;\n            box-shadow: 0 0 25px rgba(56, 189, 248, 0.5);\n        }\n\n        .welcome-card h2 {\n            font-size: 1.4rem;\n            color: #f8fafc;\n            margin-bottom: 0.5rem;\n        }\n\n        .welcome-card p {\n            color: #94a3b8;\n            font-size: 0.9rem;\n            line-height: 1.5;\n        }\n\n        /* Message bubbles */\n        .msg-row {\n            display: flex;\n            gap: 0.75rem;\n            max-width: 85%;\n        }\n\n        .msg-row.user {\n            align-self: flex-end;\n            flex-direction: row-reverse;\n        }\n\n        .msg-row.bot {\n            align-self: flex-start;\n        }\n\n        .avatar {\n            width: 32px;\n            height: 32px;\n            border-radius: 8px;\n            flex-shrink: 0;\n        }\n\n        .msg { \n            padding: 0.85rem 1.2rem; \n            border-radius: 14px; \n            line-height: 1.5; \n            font-size: 0.95rem; \n            white-space: pre-wrap; \n        }\n\n        .user .msg { \n            background: linear-gradient(135deg, #2563eb, #7c3aed); \n            color: white; \n            border-bottom-right-radius: 2px; \n        }\n\n        .bot .msg { \n            background: #131c2e; \n            border: 1px solid rgba(56, 189, 248, 0.15); \n            color: #e2e8f0; \n            border-bottom-left-radius: 2px; \n        }\n\n        /* Quick prompts */\n        .quick-prompts { \n            display: flex; \n            gap: 0.6rem; \n            padding: 0.5rem 1.5rem; \n            overflow-x: auto; \n        }\n\n        .quick-btn { \n            background: #131c2e; \n            border: 1px solid rgba(56, 189, 248, 0.3); \n            color: #cbd5e1; \n            padding: 0.45rem 0.9rem; \n            border-radius: 8px; \n            cursor: pointer; \n            font-size: 0.82rem; \n            white-space: nowrap; \n            transition: all 0.2s;\n        }\n\n        .quick-btn:hover { \n            background: #1e293b; \n            border-color: #38bdf8;\n            color: white;\n        }\n\n        /* Footer input */\n        footer { \n            padding: 1rem 1.5rem; \n            background: #0f172a; \n            border-top: 1px solid rgba(255, 255, 255, 0.08); \n        }\n\n        form { display: flex; gap: 0.6rem; }\n        \n        input { \n            flex: 1; \n            padding: 0.85rem 1rem; \n            border-radius: 10px; \n            border: 1px solid #334155; \n            background: #090d16; \n            color: white; \n            font-size: 0.95rem;\n            outline: none; \n        }\n\n        input:focus { \n            border-color: #38bdf8; \n            box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);\n        }\n\n        button#send { \n            background: linear-gradient(135deg, #38bdf8, #818cf8); \n            color: #090d16; \n            border: none; \n            padding: 0.85rem 1.6rem; \n            border-radius: 10px; \n            font-weight: 700; \n            cursor: pointer; \n            transition: opacity 0.2s;\n        }\n\n        button#send:disabled { opacity: 0.4; }\n    \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n\u003cheader\u003e\n    \u003cdiv class\u003d\"brand-box\"\u003e\n        \u003cimg src\u003d\"/logo.png\" alt\u003d\"Jupiter AI Logo\" class\u003d\"brand-logo\"\u003e\n        \u003ch1\u003eJUPITER AI\u003c/h1\u003e\n    \u003c/div\u003e\n    \u003cdiv class\u003d\"tags\"\u003e\n        \u003cspan class\u003d\"tag\"\u003e📚 Education\u003c/span\u003e\n        \u003cspan class\u003d\"tag\"\u003e🔬 Science\u003c/span\u003e\n        \u003cspan class\u003d\"tag\"\u003e💡 Daily Life\u003c/span\u003e\n    \u003c/div\u003e\n\u003c/header\u003e\n\n\u003cdiv id\u003d\"chat-window\"\u003e\n    \u003cdiv class\u003d\"welcome-card\" id\u003d\"welcome-card\"\u003e\n        \u003cimg src\u003d\"/logo.png\" alt\u003d\"Jupiter AI\" class\u003d\"welcome-logo\"\u003e\n        \u003ch2\u003eWelcome to Jupiter AI\u003c/h2\u003e\n        \u003cp\u003eYour intelligent assistant for education, scientific questions, and daily life advice. Ask anything below or choose a quick prompt to start!\u003c/p\u003e\n    \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cdiv class\u003d\"quick-prompts\"\u003e\n    \u003cbutton class\u003d\"quick-btn\" onclick\u003d\"sendPrompt(\u0027Explain quantum entanglement in simple terms\u0027)\"\u003e🔬 Quantum Physics\u003c/button\u003e\n    \u003cbutton class\u003d\"quick-btn\" onclick\u003d\"sendPrompt(\u0027How can I study effectively for exams using the Feynman technique?\u0027)\"\u003e📚 Study Technique\u003c/button\u003e\n    \u003cbutton class\u003d\"quick-btn\" onclick\u003d\"sendPrompt(\u0027How do I build a healthy daily morning routine?\u0027)\"\u003e💡 Daily Routine\u003c/button\u003e\n\u003c/div\u003e\n\n\u003cfooter\u003e\n    \u003cform id\u003d\"chat-form\"\u003e\n        \u003cinput type\u003d\"text\" id\u003d\"user-input\" placeholder\u003d\"Ask Jupiter anything...\" autocomplete\u003d\"off\" required /\u003e\n        \u003cbutton type\u003d\"submit\" id\u003d\"send\"\u003eSend\u003c/button\u003e\n    \u003c/form\u003e\n\u003c/footer\u003e\n\n\u003cscript\u003e\n    const form \u003d document.getElementById(\u0027chat-form\u0027);\n    const input \u003d document.getElementById(\u0027user-input\u0027);\n    const chatWindow \u003d document.getElementById(\u0027chat-window\u0027);\n    const sendBtn \u003d document.getElementById(\u0027send\u0027);\n    const welcomeCard \u003d document.getElementById(\u0027welcome-card\u0027);\n\n    function appendMessage(text, sender) {\n        if (welcomeCard) {\n            welcomeCard.style.display \u003d \u0027none\u0027;\n        }\n\n        const row \u003d document.createElement(\u0027div\u0027);\n        row.className \u003d `msg-row ${sender}`;\n\n        if (sender \u003d\u003d\u003d \u0027bot\u0027) {\n            const avatar \u003d document.createElement(\u0027img\u0027);\n            avatar.src \u003d \u0027/logo.png\u0027;\n            avatar.className \u003d \u0027avatar\u0027;\n            row.appendChild(avatar);\n        }\n\n        const msgDiv \u003d document.createElement(\u0027div\u0027);\n        msgDiv.className \u003d \u0027msg\u0027;\n        msgDiv.innerText \u003d text;\n        row.appendChild(msgDiv);\n\n        chatWindow.appendChild(row);\n        chatWindow.scrollTop \u003d chatWindow.scrollHeight;\n    }\n\n    async function handleMessage(text) {\n        appendMessage(text, \u0027user\u0027);\n        sendBtn.disabled \u003d true;\n\n        try {\n            const res \u003d await fetch(\u0027/api/chat\u0027, {\n                method: \u0027POST\u0027,\n                headers: { \u0027Content-Type\u0027: \u0027application/json\u0027 },\n                body: JSON.stringify({ message: text })\n            });\n            const data \u003d await res.json();\n            appendMessage(data.reply || \"Sorry, an error occurred.\", \u0027bot\u0027);\n        } catch (err) {\n            appendMessage(\"Error: Could not reach the Jupiter AI server.\", \u0027bot\u0027);\n        } finally {\n            sendBtn.disabled \u003d false;\n        }\n    }\n\n    form.addEventListener(\u0027submit\u0027, (e) \u003d\u003e {\n        e.preventDefault();\n        const text \u003d input.value.trim();\n        if (!text) return;\n        input.value \u003d \u0027\u0027;\n        handleMessage(text);\n    });\n\n    function sendPrompt(promptText) {\n        handleMessage(promptText);\n    }\n\u003c/script\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e\n```\n\n---\n\n### Step 3: Run and Preview\n\nStart your backend:\n```bash\npython main.py\n```\nVisit **`http://localhost:8000`** in your browser. You will see:\n* Your new logo in the browser tab.\n* The glowing logo and brand title at the top left.\n* The logo displayed as the bot\u0027s avatar whenever Jupiter AI replies to you.",
